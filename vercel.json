{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/|assets/|osm-(?:tashkent|location-hints)\\.json$|favicon\\.ico$|robots\\.txt$|manifest\\.webmanifest$).*)",
      "destination": "/index.html"
    }
  ]
}
